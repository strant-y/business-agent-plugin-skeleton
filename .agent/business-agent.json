{
  "ignoreDirs": ["node_modules", ".git", "dist", "build", ".idea", ".vscode", ".agent", "coverage"],
  "allowedExt": [".ts", ".tsx", ".vue", ".java", ".sql", ".xml", ".js", ".jsx"],
  "preferredEntities": [],
  "maxFileBytes": 1048576,
  "maxEntities": 100,
  "maxSampleFiles": 80,
  "maxSamplesPerExt": 40,
  "maxSampleChars": 8000,
  "relationWindow": 150,
  "analyzers": ["vue", "ast", "stores", "frontend", "linkage", "llm-rules"],
  "autoPromote": "never",
  "llm": {
    "provider": "openai-compatible",
    "model": "your-model-name",
    "baseUrl": "https://your-llm-endpoint/v1",
    "apiKeyEnv": "OPENAI_API_KEY",
    "allowSourceUpload": true
  }
}
